# copia este archivo como .env y ponle las claves reales
# el .env real NUNCA se sube a git, por eso esta en el .gitignore

# BD GENESIS - de aca sale el historico de ventas (Gen_SalesOrders etc)
GENESIS_SERVER=brsrvaz01.database.windows.net
GENESIS_DB=AgpGenesis
GENESIS_USER=usuario_aqui
GENESIS_PWD=clave_aqui

# BD SAP - de aca sacamos los atributos por ZFER (formula, vehiculo, tipo pieza, geometria)
SAP_SERVER=agpcolsap.database.windows.net
SAP_DB=DB_COL_SAP
SAP_USER=usuario_aqui
SAP_PWD=clave_aqui

# BD PRODUCTIVITY - de aca sale el stock activo (MX_StocksManager_ActiveStocks)
PRODUCTIVITY_SERVER=agpcol.database.windows.net
PRODUCTIVITY_DB=agpc-productivity
PRODUCTIVITY_USER=usuario_aqui
PRODUCTIVITY_PWD=clave_aqui

# puerto donde levanta el server flask local (pywebview le apunta a este puerto)
JORGITO_PORT=5757
